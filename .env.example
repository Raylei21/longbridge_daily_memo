# ── Longbridge Daily Brief ──
# Copy this file to .env and fill in your values.
# 所有配置均为可选 — 不设置也能正常生成日报。

# Gmail 邮件推送 (可选)
# 仅 daily_brief_auto.py 全自动推送需要。
# 日常使用 SKILL.md / generate_pdf.py / build_archive.py 都不需要。
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password

# DYLD 路径 (可选)
# 仅 Apple Silicon 上 weasyprint 找不到系统库时需要。
# DYLD_LIBRARY_PATH=/opt/homebrew/lib
